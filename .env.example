# ========================================================
# INTEGRA CARE :: HOSTEL GRIEVANCE PORTAL CONFIGURATION
# ========================================================

# 1. Server Port
PORT=3001

# 2. MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hostel_grievance_db
DB_PORT=3306

# 3. Google Workspace / Gmail Account for hostel@iul.ac.in
# How to get the 16-character Google App Password:
# 1. Sign in to hostel@iul.ac.in at https://myaccount.google.com
# 2. Go to "Security" -> Ensure "2-Step Verification" is ON
# 3. Search for "App passwords" (or go to Security -> 2-Step Verification -> App passwords)
# 4. Create a new App Password named "Hostel Portal"
# 5. Google will display a 16-character code (e.g. "abcd efgh ijkl mnop")
# 6. Paste it below as EMAIL_PASS:
EMAIL_USER=hostel@iul.ac.in
EMAIL_PASS=your_16_character_app_password_here
